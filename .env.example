# Port for VEIL Demo Server (Default: 3000)
DEMO_PORT=3000

# VLM Reasoning Mode: DEMO_MODE (default offline deterministic), LOCAL_OLLAMA, or CLOUD_API
VEIL_VLM_MODE=DEMO_MODE

# VLM Endpoint URL (optional, for LOCAL_OLLAMA or CLOUD_API)
VEIL_VLM_ENDPOINT=http://localhost:11434/api/generate

# VLM API Key (optional, for CLOUD_API)
VEIL_VLM_API_KEY=

# Ollama Model Name (optional)
VEIL_OLLAMA_MODEL=qwen2-vl:7b
