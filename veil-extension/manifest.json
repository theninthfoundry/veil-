{
  "manifest_version": 3,
  "name": "VEIL — privacy firewall for browser agents",
  "version": "0.2.1",
  "description": "See locally. Reason remotely. Reveal nothing sensitive. On-device visual perception & privacy firewall for browser agents.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VEIL — Privacy Observatory"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "core/dom-utils.js",
        "core/detector.js",
        "core/secret-vault.js",
        "core/failure-analyzer.js",
        "core/context-builder.js",
        "core/privacy-audit.js",
        "core/risk-classifier.js",
        "core/security-ledger.js",
        "core/action-resolver.js",
        "core/action-executor.js",
        "core/agent-orchestrator.js",
        "core/comparison-builder.js",
        "content/redactor.js",
        "content/vision-fallback.js",
        "content/inspector-overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/transformers.web.min.js"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
