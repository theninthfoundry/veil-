    "start": "powershell -ExecutionPolicy Bypass -File ../scripts/start-all.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File ../scripts/doctor.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File ../scripts/verify.ps1",
    "certify": "powershell -ExecutionPolicy Bypass -File ../scripts/certify.ps1",
    "test": "node benchmark/run-all-tests.js",
    "test:all": "node benchmark/run-all-tests.js",
    "test:30-attacks": "node benchmark/run-30-attacks.js",
    "test:network": "node benchmark/run-network-forensics.js",
    "benchmark": "powershell -ExecutionPolicy Bypass -File ../scripts/benchmark.ps1",
    "test:resolver": "node benchmark/run-resolver-test.js",
    "test:security": "node benchmark/run-security-test.js",
    "test:attacks": "node benchmark/run-adversarial-attacks.js",
